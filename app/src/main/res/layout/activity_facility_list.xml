<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_lavender">
 <androidx.appcompat.widget.Toolbar android:id="@+id/facilityToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/purple_primary" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:titleTextColor="@android:color/white"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temukan fasilitas publik di Pekanbaru" android:textColor="@color/text_purple" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="@android:color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌳  Taman Kota Pekanbaru" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_purple"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Pusat Kota Pekanbaru • Taman" android:layout_marginTop="5dp"/>
     <Button android:id="@+id/btnPark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lihat Detail" android:backgroundTint="@color/purple_primary"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="@android:color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌿  Taman Alam Mayang" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_purple"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Pekanbaru, Riau • Taman" android:layout_marginTop="5dp"/>
     <Button android:id="@+id/btnAlamMayang" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lihat Detail" android:backgroundTint="@color/purple_primary"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="@android:color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏥  Rumah Sakit Umum" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_purple"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Pekanbaru, Riau • Kesehatan" android:layout_marginTop="5dp"/>
     <Button android:id="@+id/btnHospital" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lihat Detail" android:backgroundTint="@color/purple_primary"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="@android:color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏃  Lapangan Padel" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_purple"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Pekanbaru, Riau • Olahraga" android:layout_marginTop="5dp"/>
     <Button android:id="@+id/btnSport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lihat Detail" android:backgroundTint="@color/purple_primary"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
