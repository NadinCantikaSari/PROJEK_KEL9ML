<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_lavender">
 <androidx.appcompat.widget.Toolbar android:id="@+id/detailToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/purple_primary" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:titleTextColor="@android:color/white"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
   <ImageView android:layout_width="match_parent" android:layout_height="190dp" android:src="@drawable/cloudy" android:scaleType="centerCrop" android:contentDescription="Gambar ilustrasi fasilitas"/>
   <TextView android:id="@+id/tvFacilityName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Taman Kota Pekanbaru" android:textColor="@color/text_purple" android:textSize="23sp" android:textStyle="bold" android:fontFamily="@font/barlow_extrabold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="📍 Pekanbaru, Riau" android:textSize="15sp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Deskripsi Fasilitas" android:textColor="@color/text_purple" android:textSize="18sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Fasilitas publik untuk masyarakat beraktivitas, beristirahat, dan menikmati ruang terbuka. Informasi ini merupakan contoh tampilan aplikasi." android:textSize="15sp" android:lineSpacingExtra="4dp"/>
   <Button android:id="@+id/btnReportFacility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Laporkan Masalah" android:backgroundTint="@color/purple_primary"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
