<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_lavender">
 <androidx.appcompat.widget.Toolbar android:id="@+id/historyToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/purple_primary" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:titleTextColor="@android:color/white"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Riwayat Laporan" android:textColor="@color/text_purple" android:textSize="23sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Laporan yang kamu kirim akan ditampilkan di sini." android:textColor="#666666"/>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="@android:color/white">
    <TextView android:id="@+id/tvReports" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="Belum ada laporan." android:textSize="15sp" android:textColor="@color/text_purple"/>
   </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
